# =============================================================================
# Agentis — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in all required values before starting.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Lines marked REQUIRED must be set. Lines marked OPTIONAL can be left at
# their default unless you specifically need to override them.
# =============================================================================


# =============================================================================
# DATABASE (PostgreSQL via PgBouncer)
# =============================================================================

# Connection used by FastAPI/LangGraph — goes through PgBouncer (transaction mode)
# REQUIRED in production: change credentials from the defaults
AGENTIS_DATABASE_URL=postgresql+asyncpg://agentis:CHANGE_ME@pgbouncer:5432/agentis

# Direct Postgres connection — used by Alembic migrations ONLY (bypasses PgBouncer)
AGENTIS_POSTGRES_DIRECT_URL=postgresql+asyncpg://agentis:CHANGE_ME@postgres:5432/agentis

# Bare credentials used by the postgres / pgbouncer services themselves
# These must match the credentials embedded in the URLs above
POSTGRES_USER=agentis
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=agentis


# =============================================================================
# REDIS
# =============================================================================

# DB 0 — Celery broker
AGENTIS_REDIS_BROKER_URL=redis://:REDIS_PASS_HERE@redis:6379/0

# DB 1 — short-term memory cache
AGENTIS_REDIS_CACHE_URL=redis://:REDIS_PASS_HERE@redis:6379/1

# Password injected into the redis container (must match the URLs above)
REDIS_PASSWORD=REDIS_PASS_HERE


# =============================================================================
# JWT AUTHENTICATION
# =============================================================================

# Paths to RSA 4096 key pair (generated by install.sh)
AGENTIS_JWT_PRIVATE_KEY_PATH=/secrets/jwt/private.pem
AGENTIS_JWT_PUBLIC_KEY_PATH=/secrets/jwt/public.pem

# Token TTL in seconds — OPTIONAL, defaults shown
AGENTIS_JWT_ACCESS_TTL=3600        # 1 hour
AGENTIS_JWT_REFRESH_TTL=2592000    # 30 days


# =============================================================================
# WEBHOOK / ENCRYPTION
# =============================================================================

# Fernet symmetric key for encrypting webhook secrets stored in the DB.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production
AGENTIS_FERNET_KEY=CHANGE_ME_base64_fernet_key_here


# =============================================================================
# APPLICATION
# =============================================================================

# Public base URL of the API (no trailing slash)
# REQUIRED — used in SSE/webhook callbacks
AGENTIS_BASE_URL=https://agentis.example.com

# OPTIONAL
AGENTIS_ENVIRONMENT=production
AGENTIS_LOG_LEVEL=INFO
AGENTIS_DEFAULT_LANGUAGE=fr


# =============================================================================
# RATE LIMITS — OPTIONAL
# =============================================================================

AGENTIS_RATE_LIMIT_TASK_HOUR=60
AGENTIS_RATE_LIMIT_API_HOUR=1000


# =============================================================================
# LLM PROVIDER
# =============================================================================

# Supported: anthropic | openai | mistral | groq | deepseek | ollama
AGENTIS_LLM_PROVIDER=anthropic

# Model identifier for the chosen provider
AGENTIS_LLM_MODEL=claude-sonnet-4-5-20251022

# API key for the chosen provider (leave empty for Ollama)
# REQUIRED
AGENTIS_LLM_API_KEY=CHANGE_ME

# Base URL override — only needed for Ollama or self-hosted endpoints
# AGENTIS_LLM_BASE_URL=http://ollama:11434/v1

# OPTIONAL
AGENTIS_LLM_TIMEOUT_S=120
AGENTIS_CONTEXT_BUDGET=0.8
AGENTIS_MEMORY_INJECTION_TOKENS=2000


# =============================================================================
# TOKEN BUDGETS — OPTIONAL
# =============================================================================

AGENTIS_TOKEN_BUDGET_PER_TASK=100000
AGENTIS_TOKEN_BUDGET_USER_MONTHLY=2000000


# =============================================================================
# AGENT BEHAVIOUR — OPTIONAL
# =============================================================================

AGENTIS_DEFAULT_MAX_ITERATIONS=30
AGENTIS_MAX_ITERATIONS_CAP=50
AGENTIS_HITL_CONFIDENCE_THRESHOLD=0.3
AGENTIS_HITL_TIMEOUT_SECONDS=3600
AGENTIS_WORKER_CONCURRENCY=4
AGENTIS_MAX_TOTAL_FAILURES=10


# =============================================================================
# SANDBOX
# =============================================================================

# Docker image for the Kata/Docker sandbox
AGENTIS_SANDBOX_IMAGE=agentis-sandbox:latest

# Runtime: kata | gvisor | docker
AGENTIS_SANDBOX_RUNTIME=docker

# OPTIONAL
AGENTIS_SANDBOX_MAX_CONCURRENT=10
AGENTIS_SANDBOX_WARM_POOL_SIZE=2
AGENTIS_SANDBOX_TIMEOUT_SECONDS=1800
AGENTIS_SANDBOX_NETWORK=agentis_default
AGENTIS_SANDBOX_RPC_PORT=9999

# Squid egress proxy for sandbox containers (leave empty to disable)
AGENTIS_EGRESS_PROXY_URL=http://squid:3128


# =============================================================================
# TOOL SETTINGS — OPTIONAL
# =============================================================================

AGENTIS_TOOL_OUTPUT_MAX_TOKENS=8000
AGENTIS_CODE_EXECUTOR_TIMEOUT_S=120
AGENTIS_MCP_TIMEOUT_S=30


# =============================================================================
# WEB SEARCH
# =============================================================================

# Backend: brave | searxng | tavily
AGENTIS_SEARCH_BACKEND=brave

# Brave Search API key (if using brave) — REQUIRED when SEARCH_BACKEND=brave
AGENTIS_BRAVE_API_KEY=CHANGE_ME

# SearXNG URL (if using searxng)
# AGENTIS_SEARXNG_URL=http://searxng:8080

# Tavily API key (if using tavily)
# AGENTIS_TAVILY_API_KEY=CHANGE_ME


# =============================================================================
# HTTP CALLER TOOL — OPTIONAL
# =============================================================================

# Comma-separated list of allowed outbound domains for the http_caller tool
# AGENTIS_HTTP_CALLER_SAFE_DOMAINS=api.example.com,hooks.slack.com


# =============================================================================
# QDRANT (LONG-TERM MEMORY / VECTOR STORE) — OPTIONAL
# =============================================================================

AGENTIS_QDRANT_URL=http://qdrant:6333
AGENTIS_QDRANT_COLLECTION=agentis_memory


# =============================================================================
# VOYAGE AI (EMBEDDINGS)
# =============================================================================

# REQUIRED if using long-term memory (Qdrant)
AGENTIS_VOYAGE_API_KEY=CHANGE_ME

# OPTIONAL
AGENTIS_VOYAGE_MODEL=voyage-multilingual-2
AGENTIS_VOYAGE_EMBEDDING_DIM=1024
# AGENTIS_VOYAGE_BASE_URL=http://voyage-server:8080/v1   # self-hosted


# =============================================================================
# MINIO / OBJECT STORAGE
# =============================================================================

# MinIO credentials — must match MINIO_ROOT_USER/PASSWORD below
AGENTIS_MINIO_ENDPOINT=minio:9000
AGENTIS_MINIO_ACCESS_KEY=CHANGE_ME_minio_user
AGENTIS_MINIO_SECRET_KEY=CHANGE_ME_minio_password
AGENTIS_MINIO_SECURE=false

# Used by the minio Docker service itself
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# OPTIONAL
AGENTIS_MINIO_BUCKET_UPLOADS=agentis-uploads
AGENTIS_MINIO_BUCKET_ARTIFACTS=agentis-artifacts
AGENTIS_MINIO_BUCKET_BACKUPS=agentis-backups
AGENTIS_MINIO_PRESIGNED_EXPIRY_SECONDS=3600


# =============================================================================
# OBSERVABILITY
# =============================================================================

# Langfuse LLM tracing
AGENTIS_LANGFUSE_HOST=http://langfuse:3000
AGENTIS_LANGFUSE_PUBLIC_KEY=CHANGE_ME
AGENTIS_LANGFUSE_SECRET_KEY=CHANGE_ME

# Prometheus
AGENTIS_PROMETHEUS_ENABLED=true

# Loki log aggregation
# AGENTIS_LOKI_URL=http://loki:3100
AGENTIS_LOKI_APP_NAME=agentis-backend


# =============================================================================
# CLAMAV (FILE SCANNING — Phase 3B) — OPTIONAL
# =============================================================================

AGENTIS_CLAMAV_ENABLED=false
AGENTIS_CLAMAV_SOCKET=/var/run/clamav/clamd.ctl


# =============================================================================
# VOICE SERVICES (Phase 4B) — OPTIONAL
# =============================================================================

# Whisper speech-to-text model size: tiny | base | small | medium | large
AGENTIS_WHISPER_MODEL=base
AGENTIS_WHISPER_DEVICE=cpu

# Edge TTS voice
AGENTIS_TTS_VOICE=fr-FR-DeniseNeural


# =============================================================================
# FRONTEND (Next.js — not prefixed with AGENTIS_)
# =============================================================================

NEXT_PUBLIC_API_URL=https://agentis.example.com
NEXT_PUBLIC_DEFAULT_LOCALE=fr

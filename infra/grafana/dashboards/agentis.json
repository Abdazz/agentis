{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "agentis-overview",
  "title": "Agentis Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "tasks_total",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "increase(tasks_total[5m])",
          "legendFormat": "tasks_total",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 2,
      "title": "task_duration_seconds",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(task_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 3,
      "title": "tool_calls_total",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "increase(tool_calls_total[5m])",
          "legendFormat": "tool_calls_total",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 4,
      "title": "llm_tokens_total",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "increase(llm_tokens_total[5m])",
          "legendFormat": "llm_tokens_total",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 5,
      "title": "llm_latency_seconds",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(llm_latency_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 6,
      "title": "active_sessions",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "active_sessions",
          "legendFormat": "active_sessions",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 7,
      "title": "sandbox_containers_active",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "sandbox_containers_active",
          "legendFormat": "sandbox_containers_active",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 8,
      "title": "context_summarizations_total",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 8, "y": 16, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "increase(context_summarizations_total[5m])",
          "legendFormat": "context_summarizations_total",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 9,
      "title": "hitl_events_total",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "increase(hitl_events_total[5m])",
          "legendFormat": "hitl_events_total",
          "refId": "A"
        }
      ],
      "options": {}
    }
  ]
}
